{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Car sharing gateway"
    }
  ],
  "tags": [
    {
      "name": "Catalog",
      "description": "Каталог автомобілів"
    },
    {
      "name": "Telemetry",
      "description": "Остання GPS-позиція автомобіля"
    },
    {
      "name": "Booking",
      "description": "Бронювання та оренда автомобілів"
    },
    {
      "name": "Billing",
      "description": "Рахунки та оплата завершених оренд"
    },
    {
      "name": "Authentication",
      "description": "Реєстрація та авторизація"
    }
  ],
  "paths": {
    "/api/telemetry/location": {
      "post": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Зберегти останню GPS-позицію автомобіля",
        "operationId": "saveLocation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "404": {
            "description": "Автомобіль не знайдено"
          },
          "204": {
            "description": "Позицію збережено"
          }
        }
      }
    },
    "/api/cars": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Отримати список автомобілів",
        "operationId": "getCars",
        "responses": {
          "404": {
            "description": "Not Found"
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CarResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Catalog"
        ],
        "summary": "Додати автомобіль до каталогу",
        "operationId": "createCar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCarRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "404": {
            "description": "Not Found"
          },
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CarResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/start": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Почати оренду",
        "operationId": "start",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/finish": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Завершити оренду",
        "operationId": "finish",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/reserve": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Забронювати доступний автомобіль",
        "operationId": "reserve",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveBookingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "404": {
            "description": "Автомобіль не знайдено"
          },
          "409": {
            "description": "Автомобіль недоступний"
          },
          "200": {
            "description": "Автомобіль заброньовано",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/pay": {
      "post": {
        "tags": [
          "Billing"
        ],
        "summary": "Оплатити рахунок",
        "operationId": "pay",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayBillingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "404": {
            "description": "Рахунок не знайдено"
          },
          "409": {
            "description": "Рахунок вже оплачено"
          },
          "200": {
            "description": "Рахунок оплачено",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BillingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Зареєструвати користувача",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "409": {
            "description": "Conflict"
          },
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Авторизуватися та отримати JWT",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "409": {
            "description": "Conflict"
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cars/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Отримати автомобіль за ідентифікатором",
        "operationId": "getCar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Автомобіль не знайдено"
          },
          "200": {
            "description": "Автомобіль знайдено",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CarResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/history": {
      "get": {
        "tags": [
          "Billing"
        ],
        "summary": "Отримати історію рахунків",
        "operationId": "getHistory",
        "responses": {
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BillingResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LocationRequest": {
        "type": "object",
        "properties": {
          "carId": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0
          }
        },
        "required": [
          "carId",
          "latitude",
          "longitude"
        ]
      },
      "CreateCarRequest": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "model": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "registrationNumber": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "hourlyRate": {
            "type": "number",
            "minimum": 0.0
          }
        },
        "required": [
          "brand",
          "hourlyRate",
          "model",
          "registrationNumber"
        ]
      },
      "CarResponse": {
        "type": "object",
        "description": "Автомобіль, доступний у каршерінгу",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "registrationNumber": {
            "type": "string"
          },
          "hourlyRate": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "RESERVED",
              "IN_USE",
              "OUT_OF_SERVICE"
            ]
          }
        }
      },
      "BookingResponse": {
        "type": "object",
        "description": "Бронювання автомобіля",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "carId": {
            "type": "integer",
            "format": "int64"
          },
          "hourlyRate": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "RESERVED",
              "ACTIVE",
              "FINISHED",
              "CANCELLED"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReserveBookingRequest": {
        "type": "object",
        "properties": {
          "carId": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "carId"
        ]
      },
      "PayBillingRequest": {
        "type": "object",
        "properties": {
          "billingId": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "billingId"
        ]
      },
      "BillingResponse": {
        "type": "object",
        "description": "Рахунок за завершену оренду",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "bookingId": {
            "type": "integer",
            "format": "int64"
          },
          "carId": {
            "type": "integer",
            "format": "int64"
          },
          "chargedHours": {
            "type": "integer",
            "format": "int32"
          },
          "hourlyRate": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PAID"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    }
  }
}
